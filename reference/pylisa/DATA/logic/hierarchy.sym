Analog Example1
  Defpreds
    f [ role f1 ff1 fff1 role1 ] [ role f2 ff2 fff2 role2 ] ;
    g [ role g1 gg1 ggg1 role1 ] [ role g2 gg2 ggg2 role2 ] ;
  end; { def preds
  Defobjs
    x x xx xxx object ;
    y y yy yyy object ;
    z z zz zzz object ;
  end; { def objs
  DefProps
    P1 f ( x y ) ;
    P2 g ( z P1 ) ;
  end ; { def props
done ; { analog 1
